PORT=4000

# OpenRouteService API key - never put this in the mobile app.
# Get a free one at https://openrouteservice.org/dev/#/home (Tokens section)
OPEN_ROUTE_API_KEY=your_key_here

# Mapbox Geocoding API token - never put this in the mobile app.
# Get one at https://account.mapbox.com/access-tokens/
MAPBOX_ACCESS_TOKEN=your_token_here

# Secret used to sign login tokens (JWTs) - make this a long random string,
# NOT a real password or anything guessable. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change_this_secret

# PostgreSQL connection string.
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
# If you installed Postgres locally with the default setup:
DATABASE_URL=postgresql://postgres:your_postgres_password@localhost:5432/smartrouteai

# URL of the Python AI service (ai_service/main.py) - only needed if you run it on a non-default port/host.
AI_SERVICE_URL=http://localhost:5001
